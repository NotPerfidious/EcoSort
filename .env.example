# AWS S3 Active Learning Configuration
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ecosort-mlops-dvc-23l0846
ACTIVE_LEARNING_PREFIX=active-learning/incoming

# Gateway Runtime Defaults (also hot-reloadable via PUT /admin/config)
CONFIDENCE_THRESHOLD=0.75
SLA_TIMEOUT_MS=1500
SHADOW_ENABLED=true
ACTIVE_LEARNING_ENABLED=true
SAFE_DEFAULT_CATEGORY=Landfill
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_SEC=30.0